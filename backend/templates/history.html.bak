{% extends 'base.html' %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3 fade-in">
    <div>
        <h2 class="text-neon-blue m-0" style="font-family: 'Orbitron'; letter-spacing: 1px;">
            <i class="bi bi-terminal-split me-2"></i>LOG DE COMUNICACIONES
        </h2>
        <p class="text-muted m-0 font-monospace small">
            OBJETIVO: <span class="text-info fw-bold">{{ name }}</span> <span class="text-secondary">//</span> ID: {{ chat_id }}
        </p>
    </div>
    <div class="d-flex gap-2">
        <a href="/user/{{ chat_id }}/gallery" class="btn btn-sm btn-outline-warning d-flex align-items-center" style="font-family: 'Orbitron'">
            <i class="bi bi-images me-2"></i>EVIDENCIAS
        </a>
        <a href="/users" class="btn btn-sm btn-outline-light d-flex align-items-center" style="font-family: 'Orbitron'">
            <i class="bi bi-arrow-return-left me-2"></i>VOLVER
        </a>
    </div>
</div>

<div class="card bg-black border-secondary shadow-lg fade-in" style="height: 80vh; overflow: hidden;">
    <div class="card-header bg-dark bg-opacity-75 border-bottom border-secondary text-center py-2 w-100">
        <small class="text-neon-green font-monospace" style="letter-spacing: 2px;">
            <i class="bi bi-arrow-down-circle-fill me-1"></i> ORDEN: MÁS RECIENTE ARRIBA
        </small>
    </div>

    <div id="chat-box" class="card-body p-4 overflow-auto" style="background-image: radial-gradient(#1e293b 1px, transparent 1px); background-size: 20px 20px;">
        {% for msg in msgs %}
            <div class="d-flex justify-content-end mb-4">
                <div style="max-width: 75%;">
                    <div class="d-flex justify-content-end align-items-end mb-1">
                        <small class="text-muted font-monospace me-2" style="font-size: 0.7rem;">{{ msg.message.date | human_time }}</small>
                        <span class="text-info fw-bold small text-uppercase">{{ name }}</span>
                    </div>
                    
                    <div class="p-3 text-white border border-info position-relative" style="background: rgba(0, 243, 255, 0.05); border-radius: 15px 15px 0 15px;">
                        {% if msg.type == 'photo' %}
                            <div class="text-warning mb-2 border-bottom border-secondary pb-1">
                                <i class="bi bi-camera-fill me-1"></i> [ARCHIVO DE IMAGEN]
                            </div>
                        {% endif %}
                        <p class="mb-0 font-monospace" style="white-space: pre-wrap;">{{ msg.message.text }}</p>
                    </div>
                </div>
                <div class="ms-3 d-flex align-items-end">
                    <div class="rounded-circle bg-info d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                        <i class="bi bi-person-fill text-dark"></i>
                    </div>
                </div>
            </div>

            {% if msg.ai_response %}
            <div class="d-flex justify-content-start mb-5">
                <div class="me-3 d-flex align-items-start">
                    <div class="rounded-circle bg-black border border-neon-pink d-flex align-items-center justify-content-center shadow" style="width: 40px; height: 40px;">
                        <i class="bi bi-robot text-neon-pink"></i>
                    </div>
                </div>
                
                <div style="max-width: 80%;">
                    <div class="d-flex align-items-center mb-1">
                        <span class="badge bg-black text-neon-pink border border-danger me-2" style="font-size: 0.6rem;">IA CORE</span>
                        <small class="text-muted font-monospace" style="font-size: 0.7rem;">LATENCIA: {{ "%.2f"|format(msg.processed_at - msg.message.date if msg.processed_at and msg.message.date else 0) }}s</small>
                    </div>

                    <div class="p-3 text-light border border-secondary bg-dark position-relative" style="border-radius: 0 15px 15px 15px;">
                        <div class="position-absolute top-0 end-0 mt-2 me-2">
                            {% if msg.sentiment == 'POSITIVO' %} <span title="Positivo" style="font-size: 1.2rem;">😃</span>
                            {% elif msg.sentiment == 'NEGATIVO' %} <span title="Negativo" style="font-size: 1.2rem;">😡</span>
                            {% else %} <span title="Neutro" style="font-size: 1.2rem; opacity: 0.5;">😐</span> {% endif %}
                        </div>
                        <p class="mb-0" style="font-family: sans-serif; line-height: 1.5; color: #e2e8f0;">{{ msg.ai_response }}</p>
                    </div>
                </div>
            </div>
            {% endif %}
        {% else %}
            <div class="text-center text-muted mt-5"><h4 style="font-family: 'Orbitron'">SIN REGISTROS</h4></div>
        {% endfor %}
    </div>
</div>
{% endblock %}

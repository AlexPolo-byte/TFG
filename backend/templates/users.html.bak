{% extends 'base.html' %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-neon-blue"><i class="bi bi-people-fill me-2"></i>BASE DE USUARIOS</h2>
    <input type="text" id="userSearch" class="form-control w-25 bg-dark text-white border-secondary" placeholder="🔍 Buscar ID o Nombre..." style="font-family: monospace;">
</div>

<div class="row" id="usersContainer">
    {% for user in users %}
    <div class="col-md-3 user-card" data-name="{{ user.first_name }}">
        <div class="card mb-4 h-100 text-center p-3" style="border-top: 3px solid var(--neon-blue);">
            <div class="mb-2">
                <i class="bi bi-person-circle display-4 text-light opacity-50"></i>
            </div>
            <h5 class="card-title text-info fw-bold m-0">{{ user.first_name }}</h5>
            <small class="text-muted d-block mb-3">ID: {{ user._id }}</small>
            
            <div class="d-flex justify-content-center gap-2 mb-3">
                <span class="badge bg-dark border border-secondary">{{ user.msg_count }} Msgs</span>
                <span class="badge bg-dark border border-secondary">{{ user.last_msg_date | human_time }}</span>
            </div>

            <div class="d-grid gap-2">
                <a href="/user/{{ user._id }}" class="btn btn-sm btn-outline-info" style="font-family: 'Orbitron'">CHAT LOG</a>
                <a href="/user/{{ user._id }}/gallery" class="btn btn-sm btn-outline-warning" style="font-family: 'Orbitron'"><i class="bi bi-images me-1"></i> FOTOS</a>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

<script>
    document.getElementById('userSearch').addEventListener('keyup', function() {
        let filter = this.value.toUpperCase();
        document.querySelectorAll('.user-card').forEach(card => {
            let name = card.getAttribute('data-name').toUpperCase();
            card.style.display = name.indexOf(filter) > -1 ? "" : "none";
        });
    });
</script>
{% endblock %}

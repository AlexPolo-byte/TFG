<!doctype html>
<html lang="es" data-bs-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>TFG System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Roboto+Mono:wght@300;400&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/2040/2040504.png">
    
    <style>
        :root { --neon-blue: #00f3ff; --neon-pink: #ff00ff; --neon-green: #00ff99; --bg-dark: #050a0f; --card-bg: rgba(13, 20, 30, 0.85); }
        body { font-family: 'Roboto Mono', monospace; background-color: var(--bg-dark); color: #e2e8f0; background-image: linear-gradient(rgba(0, 243, 255, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 243, 255, 0.1) 1px, transparent 1px); background-size: 30px 30px; min-height: 100vh; }
        h1, h2, h3, h4, h5, .navbar-brand { font-family: 'Orbitron', sans-serif; letter-spacing: 1px; }
        .text-neon-blue { color: var(--neon-blue); text-shadow: 0 0 10px rgba(0, 243, 255, 0.5); }
        .text-neon-pink { color: var(--neon-pink); text-shadow: 0 0 10px rgba(255, 0, 255, 0.5); }
        .text-neon-green { color: var(--neon-green); text-shadow: 0 0 10px rgba(0, 255, 153, 0.5); }
        .card { background: var(--card-bg); backdrop-filter: blur(10px); border: 1px solid rgba(0, 243, 255, 0.2); box-shadow: 0 0 15px rgba(0, 0, 0, 0.5); border-radius: 8px; }
        .navbar { background: rgba(5, 10, 15, 0.9) !important; border-bottom: 2px solid var(--neon-blue); box-shadow: 0 5px 20px rgba(0, 243, 255, 0.2); }
        .nav-link:hover, .nav-link.active { color: var(--neon-blue) !important; text-shadow: 0 0 8px var(--neon-blue); }
        .fw-superbold { font-weight: 800; } .blink { animation: blinker 1.5s linear infinite; } @keyframes blinker { 50% { opacity: 0.3; } }
        .brand-icon:hover { transform: scale(1.2); transition: 0.2s; }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark mb-4 sticky-top px-3 py-2">
      <div class="container-fluid">
        <a class="navbar-brand" href="/"><i class="bi bi-cpu-fill blink me-2"></i>ALEX SYSTEM</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#n"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="n">
          <ul class="navbar-nav ms-auto gap-3 align-items-center">
            
            {% if current_user.is_authenticated %}
                <li class="nav-item"><a class="nav-link active" href="/"><i class="bi bi-speedometer2"></i> DASH</a></li>
                <li class="nav-item"><a class="nav-link" href="/users"><i class="bi bi-people"></i> USERS</a></li>
                <li class="nav-item"><a class="nav-link text-neon-pink" href="/errors"><i class="bi bi-bug"></i> ERR</a></li>
                
                <li class="nav-item border-start ps-3 d-flex gap-3">
                    <a class="nav-link brand-icon" style="color:#00ED64" href="https://cloud.mongodb.com" target="_blank"><i class="bi bi-database-fill"></i></a>
                    <a class="nav-link brand-icon" style="color:#FF6600" href="https://customer.cloudamqp.com" target="_blank"><i class="bi bi-envelope-fill"></i></a>
                    <a class="nav-link brand-icon" style="color:#F46800" href="http://192.168.1.150:3000/d/84d458be-55bd-44db-a25e-d17825701191/tfg-monitoring-pro?orgId=1&from=now-1h&to=now&timezone=browser&refresh=5s" target="_blank"><i class="bi bi-graph-up-arrow"></i></a>
                </li>

                <li class="nav-item"><a class="btn btn-sm btn-outline-danger px-3" href="/logout">SALIR</a></li>
            {% else %}
                <li class="nav-item"><a class="btn btn-sm btn-outline-info px-3" href="/login">LOGIN</a></li>
            {% endif %}
            </ul>
        </div>
      </div>
    </nav>
    <div class="container-fluid fade-in px-4">{% block content %}{% endblock %}</div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block scripts %}{% endblock %}
  </body>
</html>

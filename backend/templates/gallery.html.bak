{% extends 'base.html' %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-warning" style="font-family: 'Orbitron'"><i class="bi bi-images me-2"></i>GALERÍA DE OBJETIVO</h2>
        <p class="text-muted m-0">EVIDENCIAS VISUALES // SUJETO: <span class="text-info fw-bold">{{ name }}</span> (ID: {{ chat_id }})</p>
    </div>
    <a href="/users" class="btn btn-outline-light"><i class="bi bi-arrow-left"></i> VOLVER</a>
</div>

<div class="row" data-masonry='{"percentPosition": true }'>
    {% for img in images %}
    <div class="col-sm-6 col-lg-3 mb-4">
        <div class="card border-0 bg-black text-white overflow-hidden shadow-lg" style="border: 1px solid #333;">
            <img src="data:image/jpeg;base64,{{ img.image_data }}" class="card-img-top" style="opacity: 0.9;">
            <div class="card-body p-2">
                <div class="d-flex justify-content-between mb-1">
                    <span class="badge bg-warning text-dark" style="font-size: 0.6rem">IA VISION</span>
                    <small class="text-muted" style="font-size: 0.6rem">{{ img.processed_at | human_time }}</small>
                </div>
                <p class="card-text small text-light fst-italic" style="font-size: 0.75rem;">
                    "{{ img.ai_response[:100] }}..."
                </p>
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-12 text-center mt-5">
        <h1 class="text-muted display-1"><i class="bi bi-camera-video-off"></i></h1>
        <h4 class="text-muted">SIN DATOS VISUALES</h4>
    </div>
    {% endfor %}
</div>
<script src="https://cdn.jsdelivr.net/npm/masonry-layout@4.2.2/dist/masonry.pkgd.min.js" async></script>
{% endblock %}

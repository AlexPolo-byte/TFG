{% extends 'base.html' %}

{% block content %}
<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card p-5 shadow-lg border-0" style="width: 100%; max-width: 400px; background: rgba(5, 10, 15, 0.95); border: 1px solid var(--neon-blue); box-shadow: 0 0 30px rgba(0, 243, 255, 0.15);">
        
        <div class="text-center mb-4">
            <i class="bi bi-shield-lock-fill display-1 text-neon-blue blink"></i>
            <h2 class="mt-3 text-white" style="font-family: 'Orbitron'; letter-spacing: 2px;">ACCESO TFG</h2>
            <p class="text-muted small" style="font-family: monospace;">SISTEMA DE SEGURIDAD NIVEL 1</p>
        </div>

        {% if error %}
        <div class="alert alert-danger bg-transparent text-danger border-danger text-center" role="alert" style="font-family: monospace;">
            <i class="bi bi-exclamation-triangle me-2"></i>{{ error }}
        </div>
        {% endif %}

        <form method="POST" action="/login">
            <div class="mb-3">
                <label for="username" class="form-label text-neon-blue small">ID OPERADOR</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-person"></i></span>
                    <input type="text" name="username" class="form-control bg-dark text-white border-secondary" id="username" placeholder="admin" style="font-family: monospace;">
                </div>
            </div>
            <div class="mb-4">
                <label for="password" class="form-label text-neon-blue small">CLAVE CIFRADA</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-key"></i></span>
                    <input type="password" name="password" class="form-control bg-dark text-white border-secondary" id="password" placeholder="••••••">
                </div>
            </div>
            <button type="submit" class="btn btn-outline-info w-100 py-2 fw-bold" style="font-family: 'Orbitron'; border-color: var(--neon-blue); color: var(--neon-blue); text-shadow: 0 0 5px var(--neon-blue);">
                INICIAR SESIÓN <i class="bi bi-box-arrow-in-right ms-2"></i>
            </button>
        </form>
        
        <div class="text-center mt-4 border-top border-secondary pt-3">
            <small class="text-muted" style="font-size: 0.6rem;">PROTOCOLO DE SEGURIDAD V.2.0 // MADRID NODE</small>
        </div>
    </div>
</div>
{% endblock %}

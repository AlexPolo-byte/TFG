{% extends 'base.html' %}
{% block content %}
<h2 class="text-danger"><i class="bi bi-bug-fill"></i> Registro de Errores</h2>
<div class="alert alert-warning">
    Mostrando mensajes que no fueron procesados correctamente por la IA.
</div>

{% for err in errors %}
<div class="card border-danger mb-3">
    <div class="card-header bg-danger text-white d-flex justify-content-between">
        <span>ID: {{ err.message.message_id }}</span>
        <span>{{ err.message.date | human_time }}</span>
    </div>
    <div class="card-body">
        <h5 class="card-title">Usuario: {{ err.message.chat.first_name }}</h5>
        <p class="card-text"><strong>Input:</strong> {{ err.message.text }}</p>
        <hr>
        <p class="text-danger"><strong>Error/Estado:</strong> {{ err.status }}</p>
        <pre class="bg-black text-white p-2 rounded">{{ err | tojson(indent=2) }}</pre>
    </div>
</div>
{% else %}
<div class="text-center mt-5">
    <h3>✅ ¡Todo limpio! No hay errores registrados.</h3>
</div>
{% endfor %}
{% endblock %}

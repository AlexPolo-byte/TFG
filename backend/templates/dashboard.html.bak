{% extends 'base.html' %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4 fade-in">
    <div>
        <h2 class="text-neon-blue m-0"><i class="bi bi-cpu-fill me-2"></i>SISTEMA CENTRAL</h2>
        <p class="text-muted m-0" style="font-family: 'Roboto Mono'; font-size: 0.85rem;">
            <i class="bi bi-broadcast-pin text-neon-green me-1 blink"></i> MONITOREO EN TIEMPO REAL // ZONA: MADRID
        </p>
    </div>
    <div class="text-end">
        <small class="text-muted d-block" style="font-size: 0.7rem;">ÚLTIMO SYNC</small>
        <span class="badge bg-black border border-info text-info p-2 mt-1" style="font-family: 'Orbitron'; font-size: 1rem; box-shadow: 0 0 10px rgba(0, 243, 255, 0.2);" id="last-update">INICIANDO...</span>
    </div>
</div>

<div class="row mb-4 g-4">
    <div class="col-md-3">
        <div class="card p-3 text-center h-100 justify-content-center" style="border-color: var(--neon-blue);">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <i class="bi bi-database-fill h3 text-neon-blue" style="opacity: 0.8"></i>
                <i class="bi bi-three-dots-vertical text-muted small"></i>
            </div>
            <h1 class="fw-superbold m-0 text-neon-blue" id="counter-total" style="font-size: 2.5rem;">0</h1>
            <h6 class="text-muted text-uppercase small fw-bold mt-1">Total Procesados</h6>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card p-3 text-center h-100 justify-content-center" style="border-color: var(--neon-green);">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <i class="bi bi-calendar2-check-fill h3 text-neon-green" style="opacity: 0.8"></i>
                <span class="badge bg-dark border border-success text-success" style="font-size: 0.6rem;">24H</span>
            </div>
            <h1 class="fw-superbold m-0 text-neon-green" id="counter-today" style="font-size: 2.5rem;">0</h1>
            <h6 class="text-muted text-uppercase small fw-bold mt-1">Mensajes Hoy</h6>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 text-center h-100 justify-content-center" style="border-color: #facc15;">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <i class="bi bi-motherboard-fill h3 text-warning" style="opacity: 0.8"></i>
                <small class="text-warning">RPI 4</small>
            </div>
            <h1 class="fw-superbold m-0 text-warning" style="font-size: 2.5rem;"><span id="cpu-val">0</span>%</h1>
            <div class="progress mt-2 bg-dark" style="height: 4px;">
                <div class="progress-bar bg-warning" id="cpu-bar" style="width: 0%; box-shadow: 0 0 10px #facc15;"></div>
            </div>
            <h6 class="text-muted text-uppercase small fw-bold mt-2">Carga CPU</h6>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 text-center h-100 justify-content-center" style="border-color: var(--neon-pink);">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <i class="bi bi-shield-exclamation h3 text-neon-pink blink" style="opacity: 0.8"></i>
                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger">ALERT</span>
            </div>
            <h1 class="fw-superbold m-0 text-neon-pink" id="counter-errors" style="font-size: 2.5rem;">0</h1>
            <h6 class="text-muted text-uppercase small fw-bold mt-1">Errores Críticos</h6>
        </div>
    </div>
</div>

<div class="row mb-4 g-4">
    <div class="col-lg-8">
        <div class="card p-4 h-100 shadow-lg">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-2">
                <h5 class="card-title m-0 text-neon-blue" style="font-family: 'Orbitron'"><i class="bi bi-graph-up-arrow me-2"></i>FLUJO DE ACTIVIDAD (8H)</h5>
                <div class="d-flex align-items-center">
                    <span class="badge bg-dark border border-primary text-primary me-2"><i class="bi bi-circle-fill small me-1 blink"></i>LIVE</span>
                </div>
            </div>
            <div style="height: 300px; position: relative;">
                <canvas id="activityChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card p-4 h-100 text-center shadow-lg" style="border-color: var(--neon-pink);">
            <h5 class="card-title text-neon-pink mb-4" style="font-family: 'Orbitron'"><i class="bi bi-heart-pulse-fill me-2"></i>IA SENTIMENT</h5>
            
            <div style="height: 220px; position: relative;">
                <canvas id="sentimentChart"></canvas>
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;">
                    <h3 class="text-white m-0" style="font-family: 'Orbitron'; opacity: 0.9">AI</h3>
                    <small class="text-muted" style="font-size: 0.6rem;">ANALYSIS</small>
                </div>
            </div>
            
            <div class="d-flex justify-content-around mt-4 pt-3 border-top border-secondary">
                <small class="text-success"><i class="bi bi-emoji-smile"></i> POSITIVO</small>
                <small class="text-muted"><i class="bi bi-emoji-neutral"></i> NEUTRO</small>
                <small class="text-danger"><i class="bi bi-emoji-angry"></i> NEGATIVO</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card h-100 border-0 shadow">
            <div class="card-header bg-dark text-white border-bottom border-secondary d-flex justify-content-between align-items-center">
                <span style="font-family: 'Orbitron'"><i class="bi bi-chat-square-text-fill me-2 text-warning"></i>INTERACCIONES RECIENTES</span>
                <span class="badge bg-secondary" style="font-size: 0.6rem">AUTO-UPDATE</span>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="font-size: 0.9rem;">
                    <thead class="text-secondary text-uppercase small">
                        <tr>
                            <th>Hora</th>
                            <th>Usuario</th>
                            <th>Mensaje / Análisis</th>
                            <th class="text-center">IA Mood</th>
                            <th class="text-end">Estado</th>
                        </tr>
                    </thead>
                    <tbody id="messages-body">
                        <tr><td colspan="5" class="text-center text-muted py-4">Cargando feed en tiempo real...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100 bg-black" style="border: 1px solid var(--neon-blue);">
            <div class="card-header bg-transparent p-2 border-bottom border-secondary">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-neon-blue small fw-bold" style="font-family: 'Orbitron'"><i class="bi bi-terminal me-2"></i>SYSTEM LOGS</span>
                    <i class="bi bi-arrow-clockwise text-neon-blue" style="cursor: pointer;" onclick="fetchLogs()" id="refresh-logs"></i>
                </div>
                <div class="btn-group w-100 btn-group-sm">
                    <button class="btn btn-outline-secondary active" onclick="setFilter('ALL', this)">ALL</button>
                    <button class="btn btn-outline-success" onclick="setFilter('INFO', this)">INFO</button>
                    <button class="btn btn-outline-warning" onclick="setFilter('WARN', this)">WARN</button>
                    <button class="btn btn-outline-danger" onclick="setFilter('ERROR', this)">ERR</button>
                </div>
                <select id="log-selector" class="form-select form-select-sm bg-dark text-light border-secondary mt-2" style="font-family: monospace;">
                    <option value="worker">CONTAINER: WORKER (IA)</option>
                    <option value="backend_telegram">CONTAINER: BACKEND</option>
                    <option value="cloudflare_tunnel">CONTAINER: NETWORK</option>
                </select>
            </div>
            
            <div id="logs-container" class="card-body p-2" style="height: 300px; overflow-y: auto; font-family: 'Courier New', monospace; font-size: 0.7rem; background-color: #050a0f;">
                <div class="text-muted text-center mt-5 blink">CONECTANDO A DOCKER SOCKET...</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    // --- 1. CONFIGURACIÓN GRÁFICA ACTIVIDAD (Línea) ---
    const ctxLine = document.getElementById('activityChart').getContext('2d');
    let gradientLine = ctxLine.createLinearGradient(0, 0, 0, 400);
    gradientLine.addColorStop(0, 'rgba(0, 243, 255, 0.5)');
    gradientLine.addColorStop(1, 'rgba(0, 243, 255, 0.0)');

    const activityChart = new Chart(ctxLine, {
        type: 'line',
        data: { labels: [], datasets: [{ label: 'Tráfico', data: [], borderColor: '#00f3ff', borderWidth: 2, tension: 0.4, fill: true, backgroundColor: gradientLine, pointBackgroundColor: '#000', pointBorderColor: '#00f3ff' }] },
        options: { responsive: true, maintainAspectRatio: false, scales: { x: { grid: { display: false }, ticks: { color: '#94a3b8' } }, y: { beginAtZero: true, grid: { color: '#334155', borderDash: [5, 5] }, ticks: { color: '#94a3b8' } } }, plugins: { legend: { display: false } } }
    });

    // --- 2. CONFIGURACIÓN GRÁFICA SENTIMIENTOS (Donut) ---
    const ctxSent = document.getElementById('sentimentChart').getContext('2d');
    const sentimentChart = new Chart(ctxSent, {
        type: 'doughnut',
        data: {
            labels: ['POSITIVO', 'NEUTRO', 'NEGATIVO'],
            datasets: [{
                data: [0, 0, 0], 
                backgroundColor: ['#00ff99', '#475569', '#ff00ff'], // Verde, Gris, Rosa
                borderColor: '#1e293b', 
                borderWidth: 4,
                hoverOffset: 10
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '75%', 
            plugins: { 
                legend: { display: false },
                tooltip: { backgroundColor: 'rgba(0,0,0,0.9)', bodyFont: { family: 'Orbitron' } }
            } 
        }
    });

    // --- 3. LÓGICA DE ACTUALIZACIÓN COMPLETA (AJAX) ---
    function updateStats() {
        fetch('/api/stats').then(r => r.json()).then(data => {
            // A. Contadores
            document.getElementById('counter-total').innerText = data.total;
            document.getElementById('counter-today').innerText = data.today;
            document.getElementById('counter-errors').innerText = data.errors;
            document.getElementById('cpu-val').innerText = data.system.cpu;
            document.getElementById('cpu-bar').style.width = data.system.cpu + "%";
            document.getElementById('last-update').innerText = data.last_updated;
            
            // B. Gráfica Línea
            if (JSON.stringify(activityChart.data.labels) !== JSON.stringify(data.chart_line.labels)) {
                activityChart.data.labels = data.chart_line.labels;
                activityChart.data.datasets[0].data = data.chart_line.data;
                activityChart.update();
            }

            // C. Gráfica Sentimientos
            if (data.sentiment_data) {
                sentimentChart.data.datasets[0].data = data.sentiment_data;
                sentimentChart.update();
            }

            // D. TABLA DE MENSAJES VIVA 🚀
            const tbody = document.getElementById('messages-body');
            // Solo redibujamos si hay mensajes
            if (data.messages && data.messages.length > 0) {
                tbody.innerHTML = ''; // Limpiar anterior
                
                data.messages.forEach(msg => {
                    // Iconos de Sentimiento
                    let moodIcon = '<span title="Neutro" style="opacity:0.5">😐</span>';
                    if (msg.sentiment === 'POSITIVO') moodIcon = '<span title="Positivo">😃</span>';
                    else if (msg.sentiment === 'NEGATIVO') moodIcon = '<span title="Negativo">😡</span>';

                    // Formato Texto
                    let textDisplay = `<span class="d-inline-block text-truncate" style="max-width: 250px;">${msg.text}</span>`;
                    if (msg.type === 'photo') textDisplay = '<span class="text-warning"><i class="bi bi-camera-fill"></i> [Imagen Analizada]</span>';

                    // Badge Estado
                    let statusBadge = `<span class="badge bg-secondary rounded-pill">${msg.status}</span>`;
                    if (msg.status === 'procesado_ia') statusBadge = '<span class="badge bg-success bg-opacity-25 text-success rounded-pill border border-success">COMPLETE</span>';

                    const row = `
                        <tr>
                            <td class="text-muted font-monospace small">${msg.time}</td>
                            <td class="fw-bold text-info">${msg.user}</td>
                            <td class="text-light">${textDisplay}</td>
                            <td class="text-center h5 m-0">${moodIcon}</td>
                            <td class="text-end">${statusBadge}</td>
                        </tr>
                    `;
                    tbody.innerHTML += row;
                });
            } else if (tbody.innerHTML.includes('Cargando')) {
                 tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">Esperando interacciones...</td></tr>';
            }

        }).catch(e => console.error("API Error:", e));
    }

    // --- 4. LÓGICA DE LOGS ---
    let allLogs = [];
    let currentFilter = 'ALL';

    function fetchLogs() {
        const container = document.getElementById('log-selector').value;
        const icon = document.getElementById('refresh-logs');
        icon.classList.add('spin');
        
        fetch(`/api/logs?container=${container}`).then(r => r.json()).then(logs => {
            allLogs = logs;
            renderLogs();
            icon.classList.remove('spin');
        });
    }

    function setFilter(filter, btn) {
        currentFilter = filter;
        document.querySelectorAll('.btn-group button').forEach(b => b.classList.remove('active', 'btn-secondary', 'btn-success', 'btn-warning', 'btn-danger'));
        document.querySelectorAll('.btn-group button').forEach(b => b.classList.add('btn-outline-' + (b.innerText === 'ALL' ? 'secondary' : b.innerText === 'INFO' ? 'success' : b.innerText === 'WARN' ? 'warning' : 'danger')));
        
        btn.classList.remove('btn-outline-' + (filter==='ALL'?'secondary':filter==='INFO'?'success':filter==='WARN'?'warning':'danger'));
        btn.classList.add('active', 'btn-' + (filter==='ALL'?'secondary':filter==='INFO'?'success':filter==='WARN'?'warning':'danger'));
        renderLogs();
    }

    function renderLogs() {
        const div = document.getElementById('logs-container');
        div.innerHTML = "";
        const filtered = allLogs.filter(log => currentFilter === 'ALL' || log.level === currentFilter);
        
        if (filtered.length === 0) { div.innerHTML = '<div class="text-muted text-center mt-4">SIN DATOS</div>'; return; }

        filtered.forEach(log => {
            let color = 'text-light'; let badge = 'border-secondary text-secondary';
            if (log.level === 'ERROR') { color='text-neon-pink'; badge='border-danger text-danger'; }
            if (log.level === 'WARN') { color='text-warning'; badge='border-warning text-warning'; }
            if (log.level === 'INFO') { color='text-neon-green'; badge='border-success text-success'; }
            
            div.innerHTML += `<div class="mb-1 border-bottom border-secondary pb-1" style="border-color: rgba(255,255,255,0.1)!important">
                <span class="text-muted small me-2">[${log.time}]</span>
                <span class="badge bg-black border ${badge} me-2" style="font-size:0.6rem">${log.level}</span>
                <span class="${color}" style="word-break: break-all;">${log.msg}</span>
            </div>`;
        });
    }

    const style = document.createElement('style');
    style.innerHTML = `.spin { animation: rotation 1s infinite linear; } @keyframes rotation { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }`;
    document.head.appendChild(style);

    // Eventos
    document.getElementById('log-selector').addEventListener('change', fetchLogs);
    
    // Intervalos (Actualización cada 3 segundos)
    setInterval(updateStats, 3000); 
    setInterval(fetchLogs, 5000);   
    
    // Init
    updateStats();
    fetchLogs();
</script>
{% endblock %}
